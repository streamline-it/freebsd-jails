# {{ ansible_managed }}"
#
# startup
#
exec.start = "/bin/sh /etc/rc";
exec.stop = "/bin/sh /etc/rc.shutdown jail";
exec.clean;
enforce_statfs = 1;
allow.mount;
allow.mount.fdescfs;

{%- for item in freebsd_jails_jailinfo %}

{{ item['name'] }} {
    #
    # hostname and path
    #
    path = "{{ item['path'] }}";
    host.hostname = "{{ item['name'] }}";
    #
    # networking
    #
    ip4.addr = {{ item['ipv4_address'] }};
    interface = {{ item['nic'] }};
    #
    # permissions
    #
    mount.devfs;
    # allows for traceroute and ping inside a jail
    # disable if not needed for troublshooting
    allow.raw_sockets;
    #
    # logging
    #
    exec.consolelog = "/var/log/jails_console_${name}.log";
}


{%- endfor %}
